{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/uploads/folders",
      "destination": "/api/upload?action=folders"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}